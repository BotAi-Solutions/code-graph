# ---------------------------------------------------------------------------
# Code Knowledge Graph - environment configuration
# Copy to `.env` and adjust. Every variable is validated at startup with Zod
# (see packages/shared/src/schemas/env.schema.ts). Nothing in the codebase
# reads process.env directly outside of the config loaders.
# ---------------------------------------------------------------------------

# Runtime ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# API ----------------------------------------------------------------------
# If another service already owns 3000, change this: the web dev server reads it
# from here and points its /api proxy at the right place automatically.
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database -----------------------------------------------------------------
# Host port the Docker Compose PostgreSQL publishes on. Change it if you already
# run PostgreSQL locally on 5432, and keep DATABASE_URL below in step.
POSTGRES_PORT=5432

DATABASE_URL=postgresql://ckg:ckg@localhost:5432/code_knowledge_graph
DATABASE_POOL_MAX=10

# SCIP ---------------------------------------------------------------------
# Command used to index TypeScript/JavaScript repositories. The default runs
# the official Sourcegraph indexer from this workspace's node_modules.
SCIP_TYPESCRIPT_COMMAND=scip-typescript
SCIP_INDEX_TIMEOUT_MS=600000

# Analysis -----------------------------------------------------------------
# Directory where the worker writes per-analysis artefacts (index.scip, logs).
# Relative paths - here and in a repository's sourcePath - resolve against the
# monorepo root, not the worker's working directory, so they mean the same thing
# under `pnpm dev` and under `node dist/worker.js`.
ANALYSIS_WORKSPACE_DIR=./.workspace

# Worker -------------------------------------------------------------------
# Poll interval for the in-process queue. Replaced by BullMQ in a later phase.
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=1
